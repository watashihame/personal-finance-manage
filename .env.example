# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me_strong_password

# Flask
SECRET_KEY=change_me_random_secret_key_32chars

# Tushare（A股行情，在 tushare.pro 注册后获取）
TUSHARE_TOKEN=your_tushare_token_here

# Finnhub（美股 / 加密实时行情，免费 tier 在 finnhub.io 注册获取；
# 免费版不含日股/A股/港股。留默认占位值则不启用）
FINNHUB_API_KEY=your_finnhub_key_here

# 行情代理（仅用于 Yahoo 源 yfinance / yahoo-chart，规避数据中心 IP 被封）。
# 用 socks5h:// 让 DNS 也走代理；需宿主机能连到该地址。留空则直连。
# PRICE_PROXY=socks5h://proxy-host:1080

# 访问 Token（设置后全站强制鉴权，留空则关闭鉴权）
# ACCESS_TOKEN=your_access_token_here

# MCP HTTP 访问 Token（设置后 HTTP 模式强制鉴权，留空则关闭鉴权）
# MCP_TOKEN=your_mcp_token_here

# Cloudflare Tunnel Token（从 Zero Trust 控制台获取）
# TUNNEL_TOKEN=your_tunnel_token_here

# Nginx 监听端口（默认 80）
# NGINX_PORT=80

# MCP Server 监听端口（默认 8000，仅 streamable-http 模式使用）
# MCP_PORT=8000
